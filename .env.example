# Copy to .env (never committed). Read by deploy/compose.yaml.
DEVICE_TOKEN=            # the Kindle's bearer token: openssl rand -hex 24
SOURCE=demo              # demo (fixture pages) or http
SOURCE_URL=              # http source: base URL of the data API, e.g. http://ledger:8000/kindle
SOURCE_TOKEN=            # http source: bearer token the data API accepts
TZ=Europe/Madrid
DOMAIN=budgetbox.example.com   # used by deploy/push.sh to print the live URL
